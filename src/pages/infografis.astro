---
import Layout from "../layouts/Layout.astro";
import logoJateng from "../assets/images/logo-jateng.png";
---

<Layout title="Semua Infografis">
<header
  class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-xl border-b border-slate-200 transition-shadow duration-300"
>
  <div
    class="max-w-7xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">

      <img
            src={logoJateng.src}
            alt="Logo Jawa Tengah"
            class="w-10 h-10 object-contain"
            />

      <div>
        <div class="font-bold text-slate-900 leading-tight">
          Ekosistem Data
        </div>

        <div class="text-xs text-slate-500 uppercase tracking-wide">
          Jawa Tengah
        </div>
      </div>

    </a>

    <!-- Menu -->
    <nav class="flex items-center gap-2 text-sm font-medium">

      <a
        href="/"
        class="px-4 py-2 rounded-lg text-slate-700 hover:bg-slate-100 transition"
      >
        Beranda
      </a>

      <a
        href="/infografis"
        class="px-4 py-2 rounded-lg bg-green-100 text-green-700 font-semibold"
      >
        Semua Infografis
      </a>

    </nav>

  </div>
</header>

  <section class="max-w-7xl mx-auto px-6 py-10">

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">

  <div>
    <span class="inline-flex px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold uppercase">
      Publikasi
    </span>

    <h1 class="mt-3 text-4xl font-bold text-slate-900">
      Semua Infografis
    </h1>

    <p class="mt-2 text-slate-500 max-w-2xl">
      Kumpulan infografis dan publikasi resmi Pemerintah Provinsi Jawa Tengah.
    </p>
  </div>

  <div class="w-full lg:w-96">
    <input
      id="search"
      type="text"
      placeholder="🔍 Cari infografis..."
      class="w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
    />
  </div>

</div>

    <div class="relative">

  <!-- Tombol kiri -->
  <button
    id="prevPage"
    class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2
           z-20 w-14 h-14 rounded-full
           bg-white border border-slate-300
           shadow-lg hover:shadow-xl
           hover:bg-slate-50
           transition-all duration-300
           disabled:opacity-40
           disabled:cursor-not-allowed
           flex items-center justify-center"
  >
    ←
  </button>

  <!-- Grid -->
  <div
    id="gridInfografis"
    class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5"
  >
  </div>

  <!-- Tombol kanan -->
  <button
    id="nextPage"
    class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2
           z-20 w-14 h-14 rounded-full
           bg-white border border-slate-300
           shadow-lg hover:shadow-xl
           hover:bg-slate-50
           transition-all duration-300
           disabled:opacity-40
           disabled:cursor-not-allowed
           flex items-center justify-center"
  >
    →
  </button>

</div>

<div class="mt-6 text-center">
  <span
    id="pageInfo"
    class="text-sm text-slate-500 font-medium"
  >
    1 / 1
  </span>
</div>


</div>
  </section>

  <script is:inline>
    const grid = document.getElementById("gridInfografis");

    let allData = [];
    let filteredData = [];
    let currentPage = 1;
const perPage = 6;

   async function loadData() {
  const res = await fetch("http://127.0.0.1:8081/api/infografis");

  console.log(res);

  const json = await res.json();

  console.log(json);

  allData = json.data.sort(
    (a, b) => new Date(b.tanggal) - new Date(a.tanggal)
  );

  filteredData = [...allData];

  render(filteredData);
}

    function render(data) {
        const totalPages = Math.ceil(data.length / perPage);

if (currentPage > totalPages) {
  currentPage = 1;
}

const start = (currentPage - 1) * perPage;
const end = start + perPage;

const pageData = data.slice(start, end);
  grid.innerHTML = pageData
    .map((item, index) => `
      <div class="group bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">

        <div class="relative overflow-hidden">

          <img
            src="${item.gambar}"
            alt="${item.judul}"
            class="w-full aspect-[3/2] object-cover group-hover:scale-105 transition duration-300"
          />

          ${
            index === 0
              ? `
              <span class="absolute top-3 left-3 bg-red-500 text-white text-[11px] px-3 py-1 rounded-full font-bold shadow">
                TERBARU
              </span>
              `
              : ""
          }

        </div>

        <div class="p-4">

          <div class="flex justify-between items-center">

            <span class="text-xs uppercase tracking-wider font-semibold text-green-700">
              ${item.kategori}
            </span>

            <span class="text-xs text-slate-400">
              ${new Date(item.tanggal).toLocaleDateString("id-ID")}
            </span>

          </div>

          <h3 class="mt-2 text-base font-semibold text-slate-800 line-clamp-2 leading-snug">
            ${item.judul}
          </h3>

          <div class="mt-5">

            <a
                href="${item.file_download || item.gambar}"
                target="_blank"
                class="mt-3 inline-flex items-center text-xs font-semibold text-green-700 hover:text-green-900"
                >
                Lihat →
                </a>

          </div>

        </div>

      </div>
    `)
    .join("");
    document.getElementById("pageInfo").textContent =
  `${currentPage} / ${totalPages}`;

document.getElementById("prevPage").disabled = currentPage === 1;
document.getElementById("nextPage").disabled =
  currentPage === totalPages;

document.getElementById("prevPage").classList.toggle(
  "opacity-50",
  currentPage === 1
);

document.getElementById("nextPage").classList.toggle(
  "opacity-50",
  currentPage === totalPages
);
}

    document.getElementById("search").addEventListener("input", e => {

      const keyword = e.target.value.toLowerCase();

      filteredData = allData.filter(item =>
  (item.judul || "").toLowerCase().includes(keyword) ||
  (item.kategori || "").toLowerCase().includes(keyword)
);

currentPage = 1;
render(filteredData);
    });

    document.getElementById("prevPage").addEventListener("click", () => {
  if (currentPage > 1) {
    currentPage--;
    render(filteredData);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }
});

document.getElementById("nextPage").addEventListener("click", () => {
  const totalPages = Math.ceil(filteredData.length / perPage);

  if (currentPage < totalPages) {
    currentPage++;
    render(filteredData);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }
});

// WAJIB ADA
loadData();

  </script>

</Layout>