---

---

<section id="tentang" class="relative h-[calc(100vh-5rem)] flex flex-col justify-center bg-surface snap-start overflow-hidden">
  <!-- Subtle background decoration -->
  <div
    class="absolute top-0 right-0 w-96 h-96 pointer-events-none opacity-30"
    style="background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);"
  ></div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 pointer-events-none opacity-30"
    style="background: radial-gradient(circle, rgba(255, 107, 53, 0.08) 0%, transparent 70%);"
  ></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
      <span
        class="reveal-up inline-block px-4 py-1.5 rounded-full bg-blue-light text-blue-primary text-xs font-semibold tracking-wider uppercase mb-4"
      >
        Tentang Ekosistem
      </span>
      <h2
        class="reveal-up font-heading font-bold text-3xl lg:text-4xl text-text-primary leading-tight"
        style="transition-delay: 100ms;"
      >
        Satu Pintu untuk Semua<br class="hidden sm:block" /> Data Jawa Tengah
      </h2>
      <p
        class="reveal-up mt-4 text-text-body leading-relaxed"
        style="transition-delay: 200ms;"
      >
        Ekosistem Data Jateng menghubungkan tiga pilar layanan data strategis
        pemerintah provinsi dalam satu antarmuka yang sederhana dan terintegrasi.
      </p>
    </div>

    <!-- Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 stagger-children">
      <!-- Card 1: Transparansi -->
      <div
        class="reveal-up group relative p-8 rounded-2xl bg-white border border-border-ui hover:border-orange-border hover:shadow-lg hover:shadow-orange-glow transition-all duration-500 hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-orange-light flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-6 h-6 text-orange-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-lg text-text-primary mb-2">
          Transparansi Data
        </h3>
        <p class="text-sm text-text-body leading-relaxed">
          Mewujudkan keterbukaan informasi publik melalui portal data terbuka
          yang dapat diakses dan diunduh siapa saja secara gratis.
        </p>
      </div>

      <!-- Card 2: Terintegrasi -->
      <div
        class="reveal-up group relative p-8 rounded-2xl bg-white border border-border-ui hover:border-blue-border hover:shadow-lg hover:shadow-blue-glow transition-all duration-500 hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-blue-light flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-6 h-6 text-blue-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-lg text-text-primary mb-2">
          Data Terintegrasi
        </h3>
        <p class="text-sm text-text-body leading-relaxed">
          Menghubungkan data dari seluruh Organisasi Perangkat Daerah
          dalam satu platform terstandardisasi untuk pengambilan keputusan berbasis bukti.
        </p>
      </div>

      <!-- Card 3: Spasial -->
      <div
        class="reveal-up group relative p-8 rounded-2xl bg-white border border-border-ui hover:border-green-border hover:shadow-lg hover:shadow-green-glow transition-all duration-500 hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-green-light flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-6 h-6 text-green-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-lg text-text-primary mb-2">
          Pemetaan Spasial
        </h3>
        <p class="text-sm text-text-body leading-relaxed">
          Menyajikan data geospasial interaktif untuk perencanaan wilayah,
          infrastruktur, dan analisis potensi daerah berbasis peta digital.
        </p>
      </div>
    </div>
  </div>
</section>
