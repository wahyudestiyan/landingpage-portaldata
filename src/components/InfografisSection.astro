---
---

<section
  id="infografis"
  class="h-[calc(100vh-5rem)] snap-start flex items-center bg-white overflow-hidden"
>
<div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">

    <div class="flex items-end justify-between mb-8">
  <div>
    <span
      class="px-4 py-2 rounded-full bg-green-100 text-green-700 text-xs font-semibold uppercase"
    >
      Publikasi
    </span>

    <h2 class="mt-4 text-4xl font-bold text-slate-900">
      Infografis Data Jawa Tengah
    </h2>

    <p class="mt-3 text-slate-600 max-w-2xl">
      Kumpulan infografis dan publikasi data terbaru Pemerintah Provinsi Jawa Tengah.
    </p>
  </div>

  <div class="flex gap-3 items-center">
    <input
      id="searchInfografis"
      type="text"
      placeholder="Cari infografis..."
      class="px-4 py-2 border rounded-xl w-72"
    />

    <a
      href="/infografis"
      class="text-[#9CB080] font-semibold"
    >
      Lihat Semua →
    </a>
  </div>
</div>

    <div class="relative">

      <button
        id="prevBtn"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-5 z-10 w-12 h-12 rounded-full bg-white shadow-lg border"
      >
        ←
      </button>

      <div
  id="slider"
  class="flex gap-6 overflow-x-auto scroll-smooth no-scrollbar pb-2"
>
</div>

      <button
        id="nextBtn"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-5 z-10 w-12 h-12 rounded-full bg-white shadow-lg border"
      >
        →
      </button>

    </div>
  </div>
</section>

<!-- Modal Preview -->
<div
  id="previewModal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 backdrop-blur-sm"
>
  <div class="relative max-w-5xl w-[95%]">

    <!-- Tombol Close -->
    <button
      id="closeModal"
      class="absolute -top-5 right-0 bg-white rounded-full w-10 h-10 shadow-lg"
    >
      ✕
    </button>

    <div class="bg-white rounded-3xl overflow-hidden shadow-2xl animate-fade-in">

      <img
        id="previewImage"
        src=""
        class="w-full max-h-[85vh] object-contain bg-slate-100"
      />

      <div class="p-5 flex justify-between items-center">

        <h3
          id="previewTitle"
          class="text-xl font-bold"
        >
        </h3>

        <div class="flex gap-3">

          <a
            id="downloadBtn"
            href="#"
            class="px-4 py-2 rounded-lg bg-[#9CB080] text-white"
          >
            Download
          </a>

          <a
            id="openBtn"
            href="#"
            target="_blank"
            class="px-4 py-2 rounded-lg border"
          >
            Buka Penuh
          </a>

        </div>

      </div>

    </div>

  </div>
</div>
<style>
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: scale(.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.animate-fade-in {
  animation: fadeIn .2s ease;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  scrollbar-width: none;
}
</style>

<script is:inline>
const slider = document.getElementById("slider");

let allData = [];

const modal = document.getElementById("previewModal");
const previewImage = document.getElementById("previewImage");
const previewTitle = document.getElementById("previewTitle");

const downloadBtn = document.getElementById("downloadBtn");
const openBtn = document.getElementById("openBtn");

if (!slider) {
  console.error("Slider tidak ditemukan");
}

async function loadInfografis() {
  try {
    const res = await fetch("http://127.0.0.1:8081/api/infografis");
    const json = await res.json();
    console.log(json);

    if (!json.success || !Array.isArray(json.data)) {
  console.error(json);
  return;
}
if (!slider) return;
allData = json.data.sort(
  (a, b) => new Date(b.tanggal) - new Date(a.tanggal)
);

renderInfografis(allData.slice(0, 5));

    
  } catch (err) {
    console.error(err);
  }
}

function renderInfografis(data) {
  if (!slider) return;

  slider.innerHTML = data
    .map(
        (item, index) => `
      <div class="min-w-[360px] rounded-3xl overflow-hidden bg-white shadow-md border border-slate-200 hover:shadow-xl transition">

        <img
          src="${item.gambar}"
          class="w-full h-56 object-cover"
          alt="${item.judul}"
        />

        <div class="p-5">

        ${
          index === 0
            ? `
            <span class="inline-block mb-2 px-2 py-1 rounded-full bg-red-100 text-red-600 text-xs font-bold">
              TERBARU
            </span>
            `
            : ""
        }

          <span class="text-xs font-semibold uppercase tracking-wider text-[#7FA36A]">
            ${item.kategori}
          </span>

          <h3 class="mt-2 text-xl font-bold text-slate-900 line-clamp-2">
            ${item.judul}
          </h3>

          <p class="mt-2 text-sm text-slate-500">
            ${new Date(item.tanggal).toLocaleDateString("id-ID", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </p>

          <button
            class="preview-btn mt-5 inline-flex items-center gap-2 text-[#9CB080] font-semibold"
            data-image="${item.gambar}"
            data-title="${item.judul}"
          >
            Lihat Infografis →
          </button>

        </div>
      </div>
      `
    )
    .join("");

  document.querySelectorAll(".preview-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      previewImage.src = btn.dataset.image;
      previewTitle.textContent = btn.dataset.title;

      downloadBtn.href = btn.dataset.image;
      openBtn.href = btn.dataset.image;

      modal.classList.remove("hidden");
      modal.classList.add("flex");
    });
  });
}

loadInfografis();
document
  .getElementById("searchInfografis")
  ?.addEventListener("input", (e) => {

    const keyword = e.target.value.toLowerCase().trim();

    // kalau kosong, tampilkan lagi 5 terbaru
    if (keyword === "") {
      renderInfografis(allData.slice(0, 5));
      return;
    }

    const hasil = allData.filter((item) =>
      item.judul.toLowerCase().includes(keyword) ||
      item.kategori.toLowerCase().includes(keyword) ||
      (item.deskripsi || "").toLowerCase().includes(keyword)
    );

    renderInfografis(hasil.slice(0, 5));
  });
document.getElementById("nextBtn")?.addEventListener("click", () => {
  slider?.scrollBy({
    left: 380,
    behavior: "smooth",
  });
});

document.getElementById("prevBtn")?.addEventListener("click", () => {
  slider?.scrollBy({
    left: -380,
    behavior: "smooth",
  });
});





document.getElementById("closeModal")?.addEventListener("click", () => {
  modal.classList.remove("flex");
  modal.classList.add("hidden");
});

// klik area gelap untuk menutup
modal?.addEventListener("click", (e) => {
  if (e.target === modal) {
    modal.classList.remove("flex");
    modal.classList.add("hidden");
  }
});

// ESC untuk menutup
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") {
    modal.classList.remove("flex");
    modal.classList.add("hidden");
  }
});
</script>